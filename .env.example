# Node 22+：node --env-file=.env server.mjs（.env 不提交）
BREAD_AUTH_MODE=wechat
BREAD_PORT=3100
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 从微信官方后台的开发调试工具核验 OpenID 后设置；不要把密钥发到聊天中
WECHAT_MERCHANT_OPENID=
WECHAT_COURIER_OPENID=
# 可选：微信后台已获批的模板；字段名必须匹配模板，不可照抄假ID。
# 各阶段0建单、1备好、2开始配送、3送达、4签收，可各自配置。
# WECHAT_DELIVERY_TEMPLATES={"2":{"id":"实际模板ID","fields":{"thing1":"product","thing2":"location","thing3":"title"}}}
WECHAT_MINIPROGRAM_STATE=trial

# 云端容器：由平台私密环境变量注入，不复制本机 .env 到发布包
NODE_ENV=production
BREAD_STORE=mysql
BREAD_HOST=0.0.0.0
PORT=8080
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=xiaodida
# 首次身份核验期间可显式设 true；核验后移除，发布检查会拒绝 true
WECHAT_ALLOW_UNASSIGNED_OPERATORS=false
