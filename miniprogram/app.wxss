/* 校递达 · 深松绿、瓷白与暖橙消息标记 */
page{background:#e4eae6;color:#142e26;font:28rpx/1.7 -apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif}
.page{padding:32rpx;background:radial-gradient(ellipse at 100% 0%,#c8dbd0 0%,transparent 48%),radial-gradient(ellipse at 0% 60%,#e9e0cf 0%,transparent 45%);min-height:100vh;box-sizing:border-box}.app-shell{padding-bottom:210rpx}
.brand{position:relative;background:linear-gradient(120deg,#173e33,#2c594b);color:#fff9eb;padding:30rpx 32rpx;border:1rpx solid #ffffff65;border-radius:36rpx;font:48rpx/1.5 serif;letter-spacing:5rpx;box-shadow:0 16rpx 38rpx #1b453224}.brand text{font:17rpx sans-serif;letter-spacing:2rpx;color:#e1e9de;margin-left:12rpx}.campus-label{margin:18rpx 8rpx 30rpx}.muted{color:#40594e;font-size:24rpx}.title{font:600 34rpx/1.5 sans-serif;margin:26rpx 0 22rpx}.heading{font:44rpx/1.5 serif;margin:20rpx 0}.eyebrow{font-size:21rpx;letter-spacing:2rpx;color:#526b5f}.notice{font-size:23rpx;color:#805426;margin-bottom:20rpx}
.card,.account-menu{background:rgba(255,255,255,.96);border:1rpx solid #bbcfc3;border-radius:36rpx;padding:30rpx;margin:24rpx 0;box-shadow:0 12rpx 38rpx #183e2b1c,inset 0 2rpx 0 #ffffff}.card>.title:first-child{margin-top:0}.top{display:flex;justify-content:space-between;gap:16rpx;align-items:center}.badge{background:#e1eee3;color:#214e3a;padding:6rpx 22rpx;border-radius:30rpx;font-size:23rpx;font-weight:600;white-space:nowrap}
.picker,input,textarea{background:#f2f6f3;border:2rpx solid #9db6a7;border-radius:24rpx;padding:22rpx;margin:18rpx 0;box-sizing:border-box;width:100%;color:#203b33}.picker{font-size:26rpx}input{height:94rpx}textarea{min-height:160rpx}.input-placeholder,.textarea-placeholder{color:#677a6e}
button{background:#1d4c3c;color:#fffdf7;font-size:27rpx;font-weight:600;line-height:1.6;border-radius:26rpx;margin-top:20rpx;padding:22rpx 26rpx;box-shadow:0 8rpx 18rpx #1c493318}button::after{border:0}.secondary{background:#e3eee7;color:#163f2e;border:2rpx solid #91af9e;box-shadow:none}button[disabled]{background:#dce4d9;color:#5b6b5b;box-shadow:none;opacity:1}
.timeline{font-size:23rpx;line-height:1.9;color:#456552;margin:28rpx 0;border-left:3rpx solid #a2bea8;padding-left:22rpx}.review{background:#edf3e9;border-radius:24rpx;padding:24rpx;margin-top:22rpx;color:#294c39}.footer{text-align:center;padding:34rpx 0;font-size:22rpx}.order-line{display:flex;justify-content:space-between;gap:20rpx;font-size:26rpx;margin:12rpx 0}.order-filters{margin:20rpx 0 30rpx;padding:8rpx 22rpx 20rpx;background:#ffffff65;border-radius:30rpx;border:1rpx solid #ffffffcc}.order-filters .picker{font-size:24rpx;padding:18rpx;background:#ffffffbb}.order-filters button{background:#e3ede1;color:#294e3a;box-shadow:none;padding:14rpx}.items-editor{border-top:1rpx solid #dce5da;border-bottom:1rpx solid #dce5da;padding-bottom:24rpx;margin:24rpx 0}.items-editor .title{font-size:28rpx}.items-editor .muted{text-align:right;margin-top:20rpx}.item-editor-row{border-bottom:1rpx solid #e2e9de;padding-bottom:16rpx}.item-editor-row .secondary{font-size:24rpx}
.profile-banner{display:flex;align-items:center;gap:26rpx;margin:36rpx 4rpx}.profile-avatar{width:108rpx;height:108rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#315e4b,#193f32);color:#fff5df;font:48rpx serif;border-radius:36rpx;box-shadow:0 10rpx 24rpx #254b3424;border:2rpx solid #ffffff99}.profile-name{font-size:36rpx;font-weight:600}.account-menu{padding:8rpx 24rpx;overflow:hidden;margin-bottom:30rpx}.menu-row{background:transparent;color:#234a39;border-radius:0;display:flex;align-items:center;justify-content:space-between;padding:30rpx 8rpx;font-size:28rpx;text-align:left;margin:0;border-bottom:1rpx solid #e1e8dd;gap:18rpx;line-height:1.6;box-shadow:none}.menu-row text:last-child{font-size:23rpx;color:#40594d;font-weight:400}.menu-row:last-child{border-bottom:0}
.bottom-nav{position:fixed;bottom:calc(20rpx + env(safe-area-inset-bottom));left:32rpx;right:32rpx;display:flex;gap:12rpx;background:rgba(255,255,255,.94);border:2rpx solid #a9c0b3;border-radius:42rpx;padding:12rpx;z-index:20;box-shadow:0 12rpx 48rpx #24493626;backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px)}.bottom-nav .nav-item{flex:1;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;background:transparent;color:#3c574a;font-size:23rpx;line-height:1.4;border-radius:30rpx;margin:0;padding:14rpx 8rpx;box-shadow:none}.nav-symbol{font-size:36rpx;line-height:1.2;margin-bottom:6rpx}.bottom-nav .active{background:#153f30;color:#ffffff;font-weight:700}.nav-dot{position:absolute;top:14rpx;left:55%;width:12rpx;height:12rpx;border:3rpx solid #fffdf7;border-radius:50%;background:#d26327}.subpage-head{display:flex;align-items:center;justify-content:space-between;margin:20rpx 0}.back-link{font-size:25rpx;background:#ffffffed;color:#173e2d;border:2rpx solid #a2bdae;margin:0;padding:12rpx 22rpx;box-shadow:none}.login-card{padding:40rpx 32rpx}.login-card button{margin-top:36rpx}
.notice-item{padding:26rpx 22rpx;margin:18rpx 0;border:1rpx solid #c0d0c6;border-radius:24rpx;background:#f4f7f5}.notice-item.is-unread{background:#fff5e8;border-color:#deb681;border-left:7rpx solid #b85b20}.notice-item:last-child{margin-bottom:0}.notice-top,.notice-bottom{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.notice-title{font-weight:700;font-size:29rpx;color:#142f24}.notice-state{font-size:21rpx;font-weight:600;color:#fff;background:#98501e;border-radius:20rpx;padding:3rpx 14rpx;flex:none}.notice-message{font-size:25rpx;line-height:1.8;color:#294a3a;margin:16rpx 0}.notice-bottom .muted{font-size:21rpx}.notice-read{margin:0;padding:12rpx 16rpx;font-size:23rpx;line-height:1.5;background:#184b35;color:#ffffff;width:auto;box-shadow:none}.is-read .notice-state{color:#40594b;background:#e1eae4;font-weight:400}

.sync-error{padding:20rpx 24rpx;background:#fff3dd;color:#725127;border:1rpx solid #e8d7b6;border-radius:24rpx;font-size:24rpx;margin-bottom:24rpx}.sync-error button{font-size:24rpx;padding:12rpx;margin-top:14rpx}

.merchant-label{font-size:23rpx;color:#456553;margin-bottom:16rpx}

.brand{display:flex;align-items:center;gap:22rpx;padding:26rpx;letter-spacing:0}.brand-logo{flex:none;width:96rpx;height:96rpx;border-radius:26rpx}.brand-copy{flex:1;min-width:0}.brand-name{font:600 36rpx/1.5 sans-serif;letter-spacing:1rpx}.brand text{font-size:20rpx;letter-spacing:0;margin-left:0}.branch-label{color:#355e47;font-size:23rpx;margin:-14rpx 8rpx 26rpx}.profile-avatar{flex:none;display:block}

/* 订单首页：把空间留给配送任务。 */
.page{padding:26rpx}.brand{padding:22rpx 26rpx;gap:20rpx;border-radius:30rpx}.brand-logo{width:76rpx;height:76rpx;border-radius:22rpx}.brand-name{font-size:33rpx}.brand text{font-size:20rpx;line-height:1.4}.campus-label{margin:16rpx 6rpx 8rpx;font-size:22rpx}.branch-label{margin:0 6rpx 24rpx;font-size:22rpx}.orders-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:24rpx 4rpx}.orders-heading .title{margin:0 0 4rpx;font-size:35rpx}.orders-heading .muted{font-size:23rpx}.filter-toggle{margin:0;padding:16rpx 26rpx;background:#ffffffed;color:#173f2d;border:2rpx solid #a2bdae;border-radius:22rpx;box-shadow:none;font-size:24rpx;flex:none}.order-filters{margin-top:0}.delivery-card{padding:28rpx;border-radius:32rpx;margin:20rpx 0}.delivery-card .title{font-size:32rpx;margin:20rpx 0 14rpx}.delivery-card .top>.muted{font-size:21rpx;letter-spacing:1rpx}.merchant-label{margin-bottom:14rpx;font-size:22rpx}.order-amount{font-size:26rpx;font-weight:600;margin-top:14rpx}.order-slot{font-size:23rpx;margin-top:4rpx}.delivery-location{font-size:29rpx;font-weight:600;margin:18rpx 0;color:#254d3a}.stage-track{display:flex;gap:8rpx;margin:26rpx 0 16rpx}.stage-step{flex:1;text-align:center;color:#4c6356;font-size:19rpx;white-space:nowrap}.stage-bar{height:6rpx;border-radius:10rpx;background:#dce4d8;margin-bottom:10rpx}.step-done .stage-bar{background:#759880}.step-current{color:#1d4c3c;font-weight:600}.step-current .stage-bar{background:#1d4c3c}.status-0{background:#eee9da;color:#66532a}.status-2{background:#dcedef;color:#265d68}.status-3{background:#f6e8c7;color:#79531d}.status-4{background:#e8eee6;color:#52684f}.status-issue{background:#f8e1d8;color:#853b28}.details-toggle{display:flex;align-items:center;justify-content:space-between;background:transparent;color:#4e6857;border-top:1rpx solid #e0e8dd;border-radius:0;box-shadow:none;font-size:23rpx;font-weight:400;padding:20rpx 0 4rpx;margin:20rpx 0 0}.order-details{padding:20rpx 0 0}.timeline{margin:20rpx 0 0}.timeline>view{margin-bottom:14rpx}.event-time{font-size:21rpx;color:#6b7a6b}.bottom-nav{left:26rpx;right:26rpx;border-radius:36rpx;padding:8rpx}.bottom-nav .nav-item{flex-direction:row;gap:14rpx;padding:20rpx 8rpx;border-radius:27rpx;font-size:25rpx}.nav-symbol{margin:0;font-size:30rpx}.app-shell{padding-bottom:190rpx}

.confirm-overlay{position:fixed;inset:0;z-index:100;background:#173e3375;backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;padding:38rpx;box-sizing:border-box}.confirm-sheet{width:100%;box-sizing:border-box;padding:38rpx;border-radius:40rpx;background:#fcfdf8f7;border:2rpx solid #fff;box-shadow:0 24rpx 90rpx #133b3340}.confirm-emblem{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:#dfeddd;color:#254f39;font-size:36rpx}.confirm-title{font-size:36rpx;font-weight:600;margin:24rpx 0 18rpx}.confirm-copy{color:#405c4a;font-size:27rpx;line-height:1.8}.confirm-summary{background:#edf3e9;padding:24rpx;border-radius:24rpx;margin:24rpx 0;font-size:26rpx}.confirm-location{font-weight:600;color:#264f3a;margin-top:12rpx}.confirm-note{font-size:23rpx;color:#60725e}.confirm-actions{display:flex;gap:18rpx;margin-top:28rpx}.confirm-actions button{flex:1;margin:0;padding:22rpx 8rpx}
